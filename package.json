{
  "name": "pacelab",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "npm run test --workspace @pacelab/domain",
    "typecheck": "npm run typecheck --workspace @pacelab/domain && npm run typecheck --workspace @pacelab/mobile",
    "lint": "npm run lint --workspace @pacelab/mobile",
    "android": "npm run android --workspace @pacelab/mobile"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@supabase/supabase-js": "^2.118.0"
  }
}
